@model List<RaceDay.API.Models.Event>

@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-white">Organiser Dashboard</h2>
        <a asp-action="Create" class="btn btn-raceday">+ Create New Event</a>
    </div>

    <div class="card">
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Event Name</th>
                            <th>Date</th>
                            <th>Location</th>
                            <th>Distance (km)</th>
                            <th>Type</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@item.EventDate.ToString("dd MMM yyyy")</td>
                                <td>@item.Location</td>
                                <td>@item.Distance km</td>
                                <td>@(item.EventType != null ? item.EventType.TypeName : "N/A")</td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.EventId" class="btn btn-sm btn-lightblue">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@item.EventId" class="btn btn-sm btn-pink">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-center text-white">No events found. Create your first event above!</p>
            }
        </div>
    </div>
</div>