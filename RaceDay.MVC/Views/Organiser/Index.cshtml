@model List<RaceDay.API.Models.Event>

@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-white">Organiser Dashboard</h2>
        <a asp-action="Create" class="btn btn-light">+ Create New Event</a>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                   
                    <div class="card shadow h-100" style="background-color: #6f42c1; border: none;">

                        @* Show the image if it exists *@
                        @if (!string.IsNullOrEmpty(item.BannerImageUrl))
                        {
                            <img src="@item.BannerImageUrl" class="card-img-top" alt="@item.Name" style="height: 200px; object-fit: cover;">
                        }

                        <div class="card-body text-white">
                            <h5 class="card-title fw-bold">@item.Name</h5>
                            <p class="card-text mb-1">
                                <strong>Date:</strong> @item.EventDate.ToString("dd MMM yyyy")
                            </p>
                            <p class="card-text mb-1">
                                <strong>Location:</strong> @item.Location
                            </p>
                            <p class="card-text mb-3">
                                <strong>Distance:</strong> @item.Distance km
                            </p>

                            <div class="d-flex justify-content-between align-items-center mt-4">
                                @* NEW: View Enrolments Button *@
                                <a asp-action="Enrolments" asp-route-id="@item.EventId" class="btn btn-sm btn-success">
                                    View Enrolments
                                </a>
                                <a asp-action="Categories" asp-route-id="@item.EventId" class="btn btn-sm btn-warning me-2">Manage Categories</a>

                                <div>
                                    <a asp-action="Edit" asp-route-id="@item.EventId" class="btn btn-sm btn-light me-1">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@item.EventId" class="btn btn-sm btn-danger">Delete</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center text-white mt-5">
            <h3>No events found. Click "Create New Event" to add one!</h3>
        </div>
    }
</div>